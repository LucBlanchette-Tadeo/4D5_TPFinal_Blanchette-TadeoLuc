@model NHLFictif_TPFinal.ViewModels.ConnexionViewModel

<h2>Connexion</h2>

<form asp-action="Connexion" method="post">
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Pseudonyme"></label>
        <input asp-for="Pseudonyme" />
        <span asp-validation-for="Pseudonyme"></span>
    </div>

    <div>
        <label asp-for="MotDePasse"></label>
        <input asp-for="MotDePasse" />
        <span asp-validation-for="MotDePasse"></span>
    </div>

    <button type="submit">Se connecter</button>
</form>