@model IEnumerable<NHLFictif_TPFinal.Models.VwStatistiquesEquipe>

<h1>Statistiques des équipes</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Équipe</th>
            <th>Ville</th>
            <th>Division</th>
            <th>Buts Totaux</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NomEquipe</td>
                <td>@item.Ville</td>
                <td>@item.Division</td>
                <td>@item.ButsTotalEquipe</td>
            </tr>
        }
    </tbody>
</table>